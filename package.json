{
  "name": "api-audit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.7.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm exec nx run-many -t build --parallel=1",
    "test": "pnpm exec nx run-many -t test --parallel=1",
    "lint": "pnpm exec nx run-many -t lint --parallel=1",
    "check:spec": "bash tools/check-spec.sh",
    "start": "node apps/cli/bin/nx-pn.mjs",
    "start:no-open": "node apps/cli/bin/nx-pn.mjs --no-open",
    "dev": "pnpm build && node apps/cli/bin/nx-pn.mjs"
  },
  "devDependencies": {
    "@flowot/nx-pn": "workspace:^",
    "esbuild": "^0.24.0",
    "nx": "19.8.6",
    "typescript": "5.6.3"
  }
}
