{
  "name": "{{pluginId}}",
  "version": "{{version}}",
  "description": "{{title}} plugin for nx-pn",
  "type": "module",
  "main": "host.js",
  "module": "host.js",
  "types": "host.d.ts",
  "exports": {
    ".": { "types": "./host.d.ts", "import": "./host.js" },
    "./browser": "./browser.js"
  },
  "files": ["host.js", "host.d.ts", "browser.js", "manifest.json", "README.md"],
  "peerDependencies": { "@flowot/nx-pn-host": "^{{version}}" },
  "devDependencies": {
    "@flowot/nx-pn-client": "^{{version}}",
    "@flowot/nx-pn-hmr": "^{{version}}",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "typescript": "5.6.3"
  },
  "dependencies": {},
  "scripts": {
    "build": "node ../../scripts/build.mjs {{pluginId}}",
    "dev": "node ../../scripts/dev.mjs",
    "hmr": "node ../../scripts/dev.mjs"
  },
  "keywords": ["nx-pn", "plugin", "{{pluginId}}"],
  "license": "MIT"
}
