{
  "name": "@flowot/nx-pn",
  "version": "0.2.0",
  "description": "nx-pn CLI — start the api-audit web workbench, install/uninstall plugins (npx @flowot/nx-pn)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/nx-pn.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": { "nx-pn": "./bin/nx-pn.mjs" },
  "files": ["bin", "lib", "!lib/*.tsbuildinfo"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@flowot/nx-pn-host": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
