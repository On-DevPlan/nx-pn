{
  "name": "@api-audit/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/main.tsx",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build-vendor.mjs && vite build",
    "dev": "node scripts/build-vendor.mjs && vite",
    "watch": "vite build --watch --no-emptyOutDir",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@api-audit/client": "workspace:^",
    "@api-audit/core": "workspace:^",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.24.0",
    "rollup": "^4.63.1",
    "typescript": "5.6.3",
    "vite": "^5.4.8",
    "vitest": "2.1.5"
  }
}
