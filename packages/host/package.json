{
  "name": "@flowot/nx-pn-host",
  "version": "0.2.1",
  "description": "Node runtime for the nx-pn plugin platform: HTTP/WS server, cordis services, plugin loader/installer",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/nx-pn.git",
    "directory": "packages/host"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "!lib/*.tsbuildinfo",
    "!lib/_test-t*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@flowot/nx-pn-core": "workspace:^",
    "@flowot/nx-pn-web": "workspace:^",
    "cordis": "^4.0.0-rc.9",
    "esbuild": "^0.24.0",
    "undici": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
